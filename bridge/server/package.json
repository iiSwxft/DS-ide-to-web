{
  "name": "ds-ide-to-web-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local bridge that lets any AI/IDE/tool talk to the DeepSeek web app through a browser extension (OpenAI-compatible HTTP + MCP).",
  "license": "Apache-2.0",
  "bin": {
    "ds-bridge": "./daemon.mjs",
    "ds-bridge-mcp": "./mcp-stdio.mjs"
  },
  "scripts": {
    "start": "node daemon.mjs",
    "mcp": "node mcp-stdio.mjs",
    "test": "node --test test/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "ws": "8.18.3",
    "zod": "3.25.76"
  },
  "engines": {
    "node": ">=20"
  }
}
