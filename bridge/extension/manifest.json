{
  "manifest_version": 3,
  "name": "DeepSeek Bridge",
  "version": "0.1.0",
  "description": "Use your logged-in DeepSeek web chat from any AI tool through a localhost bridge (OpenAI-compatible API + MCP).",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://chat.deepseek.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "deepseek/sha3_wasm_bg.wasm"
      ],
      "matches": [
        "https://chat.deepseek.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "DeepSeek Bridge",
    "default_popup": "options.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
